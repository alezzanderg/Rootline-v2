// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  CREW_LEAD
  TECHNICIAN
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum QuotePaymentMethod {
  STRIPE
  MERCURY
  CASH
  CHECK
}

enum QuoteServiceFrequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InventoryUnit {
  BAG
  LB
  KG
  LITER
  GALLON
  UNIT
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ServiceCategory {
  CORE
  ADD_ON
  CLEANUP
}

enum PlanTier {
  SMALL
  MEDIUM
  LARGE
}

enum ServicePricingMode {
  FREQ_AND_TIER
  TIER_ONLY
  FREQ_ONLY
}

enum QuoteLineType {
  REQUIRED
  OPTION
  ADDON
}

enum QuoteSelectionType {
  SINGLE_SELECT
  MULTI_SELECT
}

enum QuoteRecurringInterval {
  WEEKLY
  EVERY_4_WEEKS
  MONTHLY
  QUARTERLY
  YEARLY
}

enum OperatingTxnType {
  CAPITAL_CONTRIBUTION
  PARTNER_LOAN
  PARTNER_REIMBURSEMENT
  COMPANY_EXPENSE
  PROJECT_EXPENSE
  SALES_TAX_REMITTANCE
}

model Partner {
  id           String   @id @default(uuid())
  name         String
  email        String?
  phone        String?
  ownershipPct Decimal? @db.Decimal(5, 2)
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions OperatingTransaction[]
}

model OperatingTransaction {
  id            String           @id @default(uuid())
  type          OperatingTxnType
  amount        Decimal          @db.Decimal(12, 2)
  occurredAt    DateTime         @default(now())
  description   String?
  category      String?
  vendor        String?
  invoiceNumber String?
  receiptUrl    String?
  /** Whether this moved real cash through the company bank account (false = in-kind, e.g. a partner paying a vendor directly) */
  affectsCash   Boolean          @default(true)
  partnerId     String?
  jobId         String?
  quoteId       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quote   Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([type, occurredAt])
  @@index([partnerId])
  @@index([jobId])
  @@index([quoteId])
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum MembershipStartWeek {
  THIS_WEEK
  NEXT_WEEK
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  /**
   * Panel permission level. Kept on User (not joined from Employee by email) so
   * authorization never depends on a fragile email match. Existing rows default
   * to ADMIN because that is what every panel user effectively was before roles
   * were enforced. Synced from Employee.role by upsertPanelUserForEmployee.
   */
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer?
  emailSignature EmailSignature?
  auditLogs AdminAuditLog[]
}

/**
 * Append-only trail of admin mutations. Records WHO did WHAT to WHICH record.
 * Never stores payloads (no phone numbers, no amounts) so the log itself is not
 * a new place customer data can leak from.
 */
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String
  action     String
  entityType String
  entityId   String?
  outcome    String   @default("ok")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model Customer {
  id        String   @id @default(uuid())
  userId    String?  @unique
  firstName String
  lastName  String
  phone     String
  email     String?
  /** Mercury Accounts Receivable customer id for online invoicing */
  mercuryCustomerId String? @unique
  notes            String?
  difficulty       DifficultyLevel?
  isActive         Boolean  @default(true)
  /** Soft delete. Records are never hard-deleted; archived rows stay queryable. */
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  properties Property[]
  quotes     Quote[]
  memberships CustomerMembership[]
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([archivedAt])
}

model Property {
  id          String   @id @default(uuid())
  customerId  String
  label       String?
  street      String
  city        String
  state       String   @default("NJ")
  zipCode     String
  accessNotes          String?
  lotSizeSqFt          Int?
  flowerBedsCount      Int?
  shrubsCount          Int?
  treesCount           Int?
  turfAreaSqFt         Int?
  bedsAreaSqFt         Int?
  hardscapeAreaSqFt    Int?
  yardFront            Boolean          @default(false)
  yardBack             Boolean          @default(false)
  yardSides            Boolean          @default(false)
  jobDifficulty        DifficultyLevel?
  estimatedDurationMin Int?
  /** Soft delete. Records are never hard-deleted; archived rows stay queryable. */
  archivedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs        Job[]
  quotes      Quote[]
  memberships CustomerMembership[]

  @@index([archivedAt])
}

model ServiceCatalog {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  description      String?
  /** Longer explanation shown behind the (i) info icon in the admin catalog */
  details          String?
  category         ServiceCategory @default(CORE)
  /** How this service is priced: by frequency+size, size only, or frequency only */
  pricingMode      ServicePricingMode @default(FREQ_AND_TIER)
  defaultPrice     Decimal? @db.Decimal(10, 2)
  /** Weekly per-visit by yard size */
  smallPrice       Decimal? @db.Decimal(10, 2)
  mediumPrice      Decimal? @db.Decimal(10, 2)
  largePrice       Decimal? @db.Decimal(10, 2)
  biweeklySmallPrice   Decimal? @db.Decimal(10, 2)
  biweeklyMediumPrice  Decimal? @db.Decimal(10, 2)
  biweeklyLargePrice   Decimal? @db.Decimal(10, 2)
  oneTimeSmallPrice    Decimal? @db.Decimal(10, 2)
  oneTimeMediumPrice   Decimal? @db.Decimal(10, 2)
  oneTimeLargePrice    Decimal? @db.Decimal(10, 2)
  startingAtPrice  Decimal? @db.Decimal(10, 2)
  maxRangePrice    Decimal? @db.Decimal(10, 2)
  biweeklyStartingAtPrice Decimal? @db.Decimal(10, 2)
  oneTimeStartingAtPrice  Decimal? @db.Decimal(10, 2)
  memberDiscount   Decimal? @db.Decimal(5, 2)
  pricingUnit      String?
  includes         Json?
  displayOrder     Int      @default(0)
  estimatedMinutes Int?
  active           Boolean  @default(true)
  /** Soft delete. QuoteItem/JobItem reference this with onDelete: Restrict. */
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quoteItems QuoteItem[]
  jobItems   JobItem[]

  @@index([archivedAt])
}

model MembershipPlan {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  description       String?
  tier              PlanTier
  monthlyPrice      Decimal  @db.Decimal(10, 2)
  visitsPerMonth    Int      @default(4)
  addOnDiscount     Decimal  @default(0) @db.Decimal(5, 2)
  priorityScheduling Boolean @default(true)
  benefits          Json?
  active            Boolean  @default(true)
  /** One-off plan created for a specific quote/customer; hidden from the general catalog */
  isCustom          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customers  CustomerMembership[]
  quoteItems QuoteItem[]
}

model CustomerMembership {
  id                String               @id @default(uuid())
  customerId        String
  planId            String
  propertyId        String?
  status            MembershipStatus     @default(ACTIVE)
  startWeek         MembershipStartWeek?
  preferredWeekday  Int?
  preferredDay      String?
  preferredTime     String?
  notes             String?
  startsAt          DateTime             @default(now())
  endsAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  property Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
}

model Quote {
  id                String                 @id @default(uuid())
  customerId        String
  propertyId        String?
  serviceFrequency  QuoteServiceFrequency? @default(ONE_TIME)
  planTier          PlanTier?
  status            QuoteStatus            @default(DRAFT)
  subtotal    Decimal     @default(0) @db.Decimal(10, 2)
  tax         Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @default(0) @db.Decimal(10, 2)
  validUntil  DateTime?
  sentAt      DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  notes       String?
  publicToken String?  @unique
  signatureData String? @db.Text
  signedAt    DateTime?
  /** Mercury AR invoice — card/ACH payments via https://app.mercury.com/pay/{slug} */
  mercuryInvoiceId     String?   @unique
  mercuryInvoiceSlug   String?
  mercuryInvoiceStatus String?
  paidAt               DateTime?
  paymentMethod        QuotePaymentMethod?
  paymentNote          String?
  /** When false, the public estimate hides online checkout from the customer */
  paymentsEnabled      Boolean   @default(true)
  /** Set once a recurring membership line on this quote has been auto-assigned */
  membershipAssignedAt DateTime?
  /** Include the first recurring cycle in the "total due now" instead of only later */
  collectFirstCycleNow Boolean   @default(false)
  /** Immutable snapshot of selected items/options/totals captured at acceptance */
  acceptanceSnapshot   Json?
  /** Soft delete. Quotes are financial records and are never hard-deleted. */
  archivedAt           DateTime?
  /** Stripe Checkout — card payments without Mercury AR subscription */
  stripeCheckoutSessionId String? @unique
  stripeCheckoutUrl       String?
  stripePaymentStatus     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  items    QuoteItem[]
  optionGroups QuoteOptionGroup[]
  jobs     Job[]
  operatingExpenses OperatingTransaction[]
}

model QuoteOptionGroup {
  id            String             @id @default(uuid())
  quoteId       String
  title         String
  description   String?
  selectionType QuoteSelectionType @default(SINGLE_SELECT)
  required      Boolean            @default(true)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  quote Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items QuoteItem[]

  @@index([quoteId])
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String
  serviceId   String?
  planId      String?
  /** Snapshot label for plan/custom lines (when there is no service) */
  name        String?
  /** REQUIRED (always charged), OPTION (one per choice group), or ADDON (optional) */
  lineType    QuoteLineType @default(REQUIRED)
  optionGroupId String?
  /** Whether this option/add-on is currently selected (REQUIRED is always treated as selected) */
  isSelected  Boolean  @default(true)
  selectedByDefault Boolean @default(false)
  /** Whether tax applies to this line */
  taxable     Boolean  @default(true)
  /** Highlight an option as Recommended / Best Value */
  recommended Boolean  @default(false)
  badgeLabel  String?
  /** Billing cadence for recurring lines (label/grouping only) */
  recurringInterval QuoteRecurringInterval?
  sortOrder   Int      @default(0)
  /** Recurring lines (e.g. membership plan) are shown separately and excluded from the estimate total */
  isRecurring Boolean  @default(false)
  /** Scheduling preferences captured for a membership plan line (used to auto-assign on approval) */
  planStartWeek String?
  planWeekday   Int?
  planTime      String?
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  description String?

  quote   Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  plan    MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  optionGroup QuoteOptionGroup? @relation(fields: [optionGroupId], references: [id], onDelete: SetNull)

  @@index([optionGroupId])
  @@index([planId])
}

model Employee {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  role         Role
  isActive     Boolean  @default(true)
  hiredAt      DateTime @default(now())
  availability String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments JobAssignment[]
  emailSignature EmailSignature?
}

model Job {
  id          String    @id @default(uuid())
  propertyId  String
  quoteId     String?
  title       String
  status      JobStatus @default(SCHEDULED)
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  quote       Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  assignments JobAssignment[]
  items       JobItem[]
  operatingExpenses OperatingTransaction[]

  @@index([status, scheduledAt])
  @@index([quoteId])
}

model JobAssignment {
  id         String   @id @default(uuid())
  jobId      String
  employeeId String
  assignedAt DateTime @default(now())

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([jobId, employeeId])
}

model JobItem {
  id          String   @id @default(uuid())
  jobId       String
  serviceId   String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal? @db.Decimal(10, 2)
  description String?

  job     Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Restrict)
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  website     String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  Product[]
  priceLogs SupplierPriceLog[]
}

model Product {
  id            String        @id @default(uuid())
  name          String
  sku           String?       @unique
  unit          InventoryUnit @default(UNIT)
  stockQty      Decimal       @default(0) @db.Decimal(10, 2)
  reorderLevel  Decimal       @default(0) @db.Decimal(10, 2)
  unitCost      Decimal?      @db.Decimal(10, 2)
  retailPrice   Decimal?      @db.Decimal(10, 2)
  supplierId    String?
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier  Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  priceLogs SupplierPriceLog[]
}

model SupplierPriceLog {
  id         String   @id @default(uuid())
  productId  String
  supplierId String
  unitCost   Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())
  note       String?

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
  @@index([supplierId, recordedAt])
}

model Tool {
  id               String          @id @default(uuid())
  name             String
  category         String?
  brand            String?
  model            String?
  sku              String?
  serialNumber     String?         @unique
  status           EquipmentStatus @default(AVAILABLE)
  fuelType         String?
  engine           String?
  purchaseDate     DateTime?
  purchasePrice    Decimal?        @db.Decimal(10, 2)
  purchaseUrl      String?
  lastMaintenance  DateTime?
  nextMaintenance  DateTime?
  maintenanceFrequency String?
  maintenanceNotes String?
  /** Flexible spec sheet: array of { label, value } pairs (tool-specific) */
  specs            Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

enum ServiceInquiryStatus {
  NEW
  READ
  ARCHIVED
}

model ServiceInquiry {
  id        String               @id @default(uuid())
  firstName String
  lastName  String
  address   String
  email     String
  phone     String
  subject   String
  message   String
  status    ServiceInquiryStatus @default(NEW)
  locale    String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum EmailTemplateCategory {
  ESTIMATE
  INQUIRY
  GENERAL
}

enum EmailTemplateLocale {
  EN
  ES
}

model EmailTemplate {
  id          String                @id @default(uuid())
  name        String
  category    EmailTemplateCategory @default(GENERAL)
  locale      EmailTemplateLocale   @default(EN)
  /** Stable id for built-in defaults, e.g. estimate-send */
  slug        String?
  subject     String
  htmlBody    String                @db.Text
  description String?
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  sends EmailSendLog[]

  @@unique([slug, locale])
  @@index([category, locale, active])
}

model EmailSendLog {
  id           String   @id @default(uuid())
  templateId   String?
  signatureId  String?
  toEmail      String
  toName       String?
  subject      String
  status       String
  resendId     String?
  errorMessage String?
  quoteId      String?
  inquiryId    String?
  customerId   String?
  createdAt    DateTime @default(now())

  template  EmailTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  signature EmailSignature? @relation(fields: [signatureId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([toEmail])
}

model EmailSignature {
  id         String              @id @default(uuid())
  employeeId String?             @unique
  userId     String?             @unique
  fullName   String
  jobTitle   String?
  phone      String?
  email      String
  locale     EmailTemplateLocale @default(EN)
  /** When set, replaces the auto-generated signature HTML */
  htmlBody   String?             @db.Text
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  employee Employee?      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sends    EmailSendLog[]
}
