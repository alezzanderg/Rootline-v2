// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  CREW_LEAD
  TECHNICIAN
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum QuotePaymentMethod {
  STRIPE
  MERCURY
  CASH
  CHECK
}

enum QuoteServiceFrequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InventoryUnit {
  BAG
  LB
  KG
  LITER
  GALLON
  UNIT
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ServiceCategory {
  CORE
  ADD_ON
  CLEANUP
}

enum PlanTier {
  SMALL
  MEDIUM
  LARGE
}

enum ServicePricingMode {
  FREQ_AND_TIER
  TIER_ONLY
  FREQ_ONLY
}

enum OperatingTxnType {
  CAPITAL_CONTRIBUTION
  PARTNER_LOAN
  PARTNER_REIMBURSEMENT
  COMPANY_EXPENSE
  PROJECT_EXPENSE
}

model Partner {
  id           String   @id @default(uuid())
  name         String
  email        String?
  phone        String?
  ownershipPct Decimal? @db.Decimal(5, 2)
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions OperatingTransaction[]
}

model OperatingTransaction {
  id            String           @id @default(uuid())
  type          OperatingTxnType
  amount        Decimal          @db.Decimal(12, 2)
  occurredAt    DateTime         @default(now())
  description   String?
  category      String?
  vendor        String?
  invoiceNumber String?
  receiptUrl    String?
  partnerId     String?
  jobId         String?
  quoteId       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quote   Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([type, occurredAt])
  @@index([partnerId])
  @@index([jobId])
  @@index([quoteId])
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum MembershipStartWeek {
  THIS_WEEK
  NEXT_WEEK
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer?
}

model Customer {
  id        String   @id @default(uuid())
  userId    String?  @unique
  firstName String
  lastName  String
  phone     String
  email     String?
  /** Mercury Accounts Receivable customer id for online invoicing */
  mercuryCustomerId String? @unique
  notes            String?
  difficulty       DifficultyLevel?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  properties Property[]
  quotes     Quote[]
  memberships CustomerMembership[]
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Property {
  id          String   @id @default(uuid())
  customerId  String
  label       String?
  street      String
  city        String
  state       String   @default("NJ")
  zipCode     String
  accessNotes          String?
  lotSizeSqFt          Int?
  flowerBedsCount      Int?
  shrubsCount          Int?
  treesCount           Int?
  turfAreaSqFt         Int?
  bedsAreaSqFt         Int?
  hardscapeAreaSqFt    Int?
  yardFront            Boolean          @default(false)
  yardBack             Boolean          @default(false)
  yardSides            Boolean          @default(false)
  jobDifficulty        DifficultyLevel?
  estimatedDurationMin Int?
  createdAt            DateTime         @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs        Job[]
  quotes      Quote[]
  memberships CustomerMembership[]
}

model ServiceCatalog {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  description      String?
  /** Longer explanation shown behind the (i) info icon in the admin catalog */
  details          String?
  category         ServiceCategory @default(CORE)
  /** How this service is priced: by frequency+size, size only, or frequency only */
  pricingMode      ServicePricingMode @default(FREQ_AND_TIER)
  defaultPrice     Decimal? @db.Decimal(10, 2)
  /** Weekly per-visit by yard size */
  smallPrice       Decimal? @db.Decimal(10, 2)
  mediumPrice      Decimal? @db.Decimal(10, 2)
  largePrice       Decimal? @db.Decimal(10, 2)
  biweeklySmallPrice   Decimal? @db.Decimal(10, 2)
  biweeklyMediumPrice  Decimal? @db.Decimal(10, 2)
  biweeklyLargePrice   Decimal? @db.Decimal(10, 2)
  oneTimeSmallPrice    Decimal? @db.Decimal(10, 2)
  oneTimeMediumPrice   Decimal? @db.Decimal(10, 2)
  oneTimeLargePrice    Decimal? @db.Decimal(10, 2)
  startingAtPrice  Decimal? @db.Decimal(10, 2)
  maxRangePrice    Decimal? @db.Decimal(10, 2)
  biweeklyStartingAtPrice Decimal? @db.Decimal(10, 2)
  oneTimeStartingAtPrice  Decimal? @db.Decimal(10, 2)
  memberDiscount   Decimal? @db.Decimal(5, 2)
  pricingUnit      String?
  includes         Json?
  displayOrder     Int      @default(0)
  estimatedMinutes Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quoteItems QuoteItem[]
  jobItems   JobItem[]
}

model MembershipPlan {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  description       String?
  tier              PlanTier
  monthlyPrice      Decimal  @db.Decimal(10, 2)
  visitsPerMonth    Int      @default(4)
  addOnDiscount     Decimal  @default(0) @db.Decimal(5, 2)
  priorityScheduling Boolean @default(true)
  benefits          Json?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customers CustomerMembership[]
}

model CustomerMembership {
  id                String               @id @default(uuid())
  customerId        String
  planId            String
  propertyId        String?
  status            MembershipStatus     @default(ACTIVE)
  startWeek         MembershipStartWeek?
  preferredWeekday  Int?
  preferredDay      String?
  preferredTime     String?
  notes             String?
  startsAt          DateTime             @default(now())
  endsAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  property Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
}

model Quote {
  id                String                 @id @default(uuid())
  customerId        String
  propertyId        String?
  serviceFrequency  QuoteServiceFrequency? @default(ONE_TIME)
  planTier          PlanTier?
  status            QuoteStatus            @default(DRAFT)
  subtotal    Decimal     @default(0) @db.Decimal(10, 2)
  tax         Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @default(0) @db.Decimal(10, 2)
  validUntil  DateTime?
  sentAt      DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  notes       String?
  publicToken String?  @unique
  signatureData String? @db.Text
  signedAt    DateTime?
  /** Mercury AR invoice — card/ACH payments via https://app.mercury.com/pay/{slug} */
  mercuryInvoiceId     String?   @unique
  mercuryInvoiceSlug   String?
  mercuryInvoiceStatus String?
  paidAt               DateTime?
  paymentMethod        QuotePaymentMethod?
  paymentNote          String?
  /** Stripe Checkout — card payments without Mercury AR subscription */
  stripeCheckoutSessionId String? @unique
  stripeCheckoutUrl       String?
  stripePaymentStatus     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  items    QuoteItem[]
  jobs     Job[]
  operatingExpenses OperatingTransaction[]
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String
  serviceId   String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  description String?

  quote   Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Restrict)
}

model Employee {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  role         Role
  isActive     Boolean  @default(true)
  hiredAt      DateTime @default(now())
  availability String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments JobAssignment[]
}

model Job {
  id          String    @id @default(uuid())
  propertyId  String
  quoteId     String?
  title       String
  status      JobStatus @default(SCHEDULED)
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  quote       Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  assignments JobAssignment[]
  items       JobItem[]
  operatingExpenses OperatingTransaction[]
}

model JobAssignment {
  id         String   @id @default(uuid())
  jobId      String
  employeeId String
  assignedAt DateTime @default(now())

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([jobId, employeeId])
}

model JobItem {
  id          String   @id @default(uuid())
  jobId       String
  serviceId   String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal? @db.Decimal(10, 2)
  description String?

  job     Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Restrict)
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  website     String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  Product[]
  priceLogs SupplierPriceLog[]
}

model Product {
  id            String        @id @default(uuid())
  name          String
  sku           String?       @unique
  unit          InventoryUnit @default(UNIT)
  stockQty      Decimal       @default(0) @db.Decimal(10, 2)
  reorderLevel  Decimal       @default(0) @db.Decimal(10, 2)
  unitCost      Decimal?      @db.Decimal(10, 2)
  retailPrice   Decimal?      @db.Decimal(10, 2)
  supplierId    String?
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier  Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  priceLogs SupplierPriceLog[]
}

model SupplierPriceLog {
  id         String   @id @default(uuid())
  productId  String
  supplierId String
  unitCost   Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())
  note       String?

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
  @@index([supplierId, recordedAt])
}

model Tool {
  id               String          @id @default(uuid())
  name             String
  category         String?
  brand            String?
  model            String?
  sku              String?
  serialNumber     String?         @unique
  status           EquipmentStatus @default(AVAILABLE)
  fuelType         String?
  engine           String?
  purchaseDate     DateTime?
  purchasePrice    Decimal?        @db.Decimal(10, 2)
  purchaseUrl      String?
  lastMaintenance  DateTime?
  nextMaintenance  DateTime?
  maintenanceFrequency String?
  maintenanceNotes String?
  /** Flexible spec sheet: array of { label, value } pairs (tool-specific) */
  specs            Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

enum ServiceInquiryStatus {
  NEW
  READ
  ARCHIVED
}

model ServiceInquiry {
  id        String               @id @default(uuid())
  firstName String
  lastName  String
  address   String
  email     String
  phone     String
  subject   String
  message   String
  status    ServiceInquiryStatus @default(NEW)
  locale    String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
