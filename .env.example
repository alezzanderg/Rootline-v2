# Public site URL (production: https://www.rootlinenj.com)
NEXT_PUBLIC_SITE_URL=https://www.rootlinenj.com

# Postgres connection for dashboard / Prisma
DATABASE_URL=

# Mercury — online payments (Accounts Receivable invoices)
# Full token from https://app.mercury.com/settings/tokens — MUST include the secret-token: prefix
# Example: MERCURY_API_TOKEN=secret-token:mercury_production_wma_abc123...
MERCURY_API_TOKEN=
# Checking/savings account id from GET https://api.mercury.com/api/v1/accounts
MERCURY_DESTINATION_ACCOUNT_ID=

# Stripe — direct card checkout (alternative to Mercury AR)
# Active mode: STRIPE_MODE=test|live (optional). Defaults to test in dev; live in production if STRIPE_LIVE_SECRET_KEY is set.
STRIPE_MODE=test

# Test keys — https://dashboard.stripe.com/test/apikeys
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...

# Live keys — https://dashboard.stripe.com/apikeys
STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_LIVE_WEBHOOK_SECRET=whsec_...

# Legacy fallbacks (optional; used when mode-specific keys are not set)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Google Search Console → HTML tag verification (paste the content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: full Google Business Profile URL for schema sameAs
NEXT_PUBLIC_GOOGLE_BUSINESS_URL="https://www.google.com/maps/place/Rootline+Landscaping/@40.9405314,-74.0345145,34259m/data=!3m2!1e3!4b1!4m6!3m5!1s0xa0bd64970ae17bf7:0x763f661b78e51807!8m2!3d40.9405314!4d-74.0345146!16s%2Fg%2F11njgwz1ww?entry=ttu&g_ep=EgoyMDI2MDUyMC4wIKXMDSoASAFQAw%3D%3D"
